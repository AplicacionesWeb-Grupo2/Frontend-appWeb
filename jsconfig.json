{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "allowJs": true,
    "checkJs": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "src/**/*.vue",
    "*.vue"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "public"
  ],
  "vueCompilerOptions": {
    "target": 3,
    "extensions": [".vue"],
    "globalTypesPath": "./node_modules"
  }
}
